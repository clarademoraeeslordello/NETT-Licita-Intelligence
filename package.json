{
  "name": "analisador-inteligente-editais",
  "version": "1.0.0",
  "private": true,
  "description": "Analisador Inteligente de Editais — análise de licitações em PDF com IA, extração estruturada e relatório executivo em PDF.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/test-unit.mjs",
    "test:routes": "node scripts/verify-routes.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:css": "node scripts/audit-css.mjs",
    "verify": "node scripts/verify-pipeline.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:contracts && npm run test:auth && npm run test:http && npm run test:analysis && npm run test:read && npm run test:pipeline && npm run test:ui && npm run test:routes && npm run test:css",
    "test:contracts": "tsx --test src/contracts/contracts.test.ts src/server/db/schema.test.ts",
    "test:db": "tsx --test src/server/db/db.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "tsx scripts/db/bootstrap.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:setup": "npm run db:bootstrap && npm run db:migrate",
    "test:auth": "tsx --test src/server/auth/auth.test.ts",
    "test:auth:integration": "tsx --test src/server/auth/auth.integration.test.ts",
    "test:http": "tsx --test src/server/http/http.test.ts",
    "test:http:integration": "tsx --test src/server/http/http.integration.test.ts",
    "worker": "tsx worker/index.ts",
    "jobs:setup": "tsx src/server/jobs/setup.ts",
    "test:jobs": "tsx --test src/server/jobs/jobs.integration.test.ts",
    "test:storage": "tsx --test src/server/storage/storage.test.ts",
    "test:storage:integration": "tsx --test src/server/storage/storage.integration.test.ts",
    "test:sources": "tsx --test src/server/sources/pncp/pncp.test.ts",
    "test:sources:live": "tsx --test src/server/sources/pncp/pncp.live.test.ts",
    "test:sources:integration": "tsx --test src/server/sources/sources.integration.test.ts",
    "test:analysis": "tsx --test \"src/server/analysis/**/*.test.ts\" \"src/server/matching/**/*.test.ts\"",
    "test:analysis:integration": "tsx --test src/server/analysis/reviews/reviews.integration.ts src/server/matching/matching.integration.ts",
    "test:ui": "tsx --test \"src/components/**/*.test.ts\"",
    "test:pipeline": "tsx --test src/server/pipeline/pipeline.test.ts",
    "test:pipeline:integration": "tsx --test src/server/pipeline/pipeline.integration.ts",
    "test:read": "tsx --test src/server/sources/read/read.test.ts",
    "test:read:integration": "tsx --test src/server/sources/read/read.integration.test.ts",
    "search:backfill": "tsx src/server/sources/read/backfill-search.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.17",
    "next": "^15.5.25",
    "openid-client": "^6.9.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.38.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
