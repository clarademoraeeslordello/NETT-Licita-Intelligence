# Somente exemplo. Nunca coloque credenciais reais neste arquivo nem em commits.
DATABASE_URL=postgres://postgres@localhost:5440/nett_licita
DATABASE_URL_TESTE=postgres://postgres@localhost:5440/nett_licita_teste

# API interna (consumida pelo Agente 04). Token obrigatório para rotas /v1.
API_PORTA=3200
API_TOKEN_INTERNO=

# Coleta
COLETA_INTERVALO_MIN=60
PROCESSAMENTO_LIMITE_HORA=50
COLETA_JANELA_DIAS=1
FONTES_ATIVAS=pncp,comprasgov
# Modalidades PNCP (Lei 14.133): 4 concorrência eletrônica, 6 pregão eletrônico, 8 dispensa
PNCP_MODALIDADES=4,6,8
# Códigos de modalidade do Compras.gov (dadosabertos): 5 pregão eletrônico, 6 dispensa
COMPRASGOV_MODALIDADES=5,6
# Arquivo JSON do dicionário comercial da Nett (obrigatório para coletar)
DICIONARIO_COMERCIAL_ARQUIVO=config/dicionario-comercial.json

# Trello (somente leitura). Configure como segredo do ambiente.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
# Segredo da aplicação Trello para validar assinatura dos webhooks
TRELLO_APP_SECRET=
# URL pública do endpoint POST /webhooks/trello
TRELLO_WEBHOOK_URL=

# SIGA/RJ — aguardando definição de forma de acesso autorizada
SIGA_RJ_HABILITADO=false
